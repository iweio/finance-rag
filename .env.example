# ---- MySQL ----
MYSQL_ROOT_PASSWORD=rag_root_pwd
MYSQL_DATABASE=rag_finance
MYSQL_USER=rag
MYSQL_PASSWORD=rag_pwd
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=finance_clause

# ---- 后端 ----
DATABASE_URL=mysql+pymysql://rag:rag_pwd@localhost:3306/rag_finance?charset=utf8mb4
API_PREFIX=/api/v1

# ---- embedding（与 DB.md / MODULE.md 联动，冻结后不改）----
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：

# ---- rerank ----
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- LLM ----
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_API_KEY=sk-xxxxxxxx
# 若用 OpenAI 兼容接口：
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1

# ---- 数据 ----
DATA_DIR=./数据源

# ---- 知识图谱（M8，接口 10→13）----
# /graph/{stats,neighbors,subgraph} 只读这份目录，由 kg/export_serving.py 产出。
# 容器里是 /app/kg/out/serving；宿主机直跑后端就用相对路径。
# 未训练出节点表示时 embeddings.npz 不存在，has_embeddings=false，接口不受影响。
KG_SERVING_DIR=./kg/out/serving

